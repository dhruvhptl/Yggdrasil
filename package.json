{
  "name": "universal-skill-tree",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mimir": "npm --prefix sidecar start",
    "dev:scraper": "python scraper/main.py",
    "dev:all": "concurrently --names vite,scraper \"vite\" \"python scraper/main.py\"",
