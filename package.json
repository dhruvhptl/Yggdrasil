    "@tauri-apps/plugin-opener": "^2",
    "@types/d3": "^7.4.3",
    "@xyflow/react": "^12.10.1",
    "d3": "^7.9.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.555.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.10.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
