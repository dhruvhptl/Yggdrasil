{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "Universal Skill Tree",
  "version": "0.1.0",
  "identifier": "com.universal.skilltree",
  "build": {
    "beforeDevCommand": "npm run dev:all",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": { "csp": null },
    "windows": [
      {
        "title": "Universal Skill Tree",
        "width": 1200,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
